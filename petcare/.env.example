# Copy to .dev.vars for the local Cloudflare runtime. Never commit secrets.
# Manual document review works without these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Generate with: node scripts/generate-push-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:YOUR_EMAIL
CRON_SECRET=
